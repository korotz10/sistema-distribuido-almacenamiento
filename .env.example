# Plantilla: exportar las variables al entorno; no se carga automáticamente.
# Generar dos valores distintos con secrets.token_urlsafe(32).
CLIENT_API_KEY=
NODE_API_KEY=
NODE1_URL=http://127.0.0.1:8001
NODE2_URL=http://127.0.0.1:8002
NODE3_URL=http://127.0.0.1:8003
NODE_ID=node1
NODE_PORT=8001
STORAGE_DIR=./storage/node1
MAX_FILE_SIZE=104857600
MAX_CONCURRENT_TRANSFERS=4
TRANSFER_TIMEOUT=120
PENDING_TTL=600
GARBAGE_GRACE=300
MAINTENANCE_INTERVAL=30
